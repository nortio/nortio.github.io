#!/bin/sh
# the worst static site generator you've ever seen
set -e
if ! command -v pandoc >/dev/null; then
    echo "pandoc was not found!"
    exit 1
fi
mkdir -p out out/blog
outdir="$(pwd)/out"
cat top.html > out/index.html
find blog/ -maxdepth 1 -mindepth 1 -type d \
    ! -name "out" \
    ! -name ".git" \
    ! -name ".github" \
    -exec sh -c 'cd $1 && pandoc -i "post.md" -o $3/blog/$(basename "$1").html --standalone --css $2/style.css -M document-css=true -f gfm --toc --embed-resources -B $2/nav.html' - {} $(pwd) $outdir \; \
    -exec sh -c 'echo "<li><a href=\"/blog/$(basename $1).html\">$(grep -E "title:(.*)" $1/post.md | cut -d":" -f2)</a></li>" >> $3/index.html' - {} $(pwd) $outdir \;
cat bottom.html >> out/index.html
